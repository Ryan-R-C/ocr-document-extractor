# Configuração do serviço. Copie para .env (make setup faz isso) e ajuste.
# Toda configuração passa por app/config.py; nada de constante espalhada no código.

# --- Providers ----------------------------------------------------------------------------
# Fase 0: só os providers `fake` existem (respostas gravadas por hash da imagem, sem custo).
# Valores do plano para produção: openai / paddleocr (implementados nas Fases 1 e 2).
LEITOR_VISUAL_PROVIDER=fake
LEITOR_VISUAL_MODELO=gpt-6.1-terra
LEITOR_VISUAL_MODELO_ESCALADA=gpt-6.1-sol
# low | high | original | auto. A documentação da OpenAI indica `original` para OCR.
LEITOR_VISUAL_DETALHE=original
# unico: uma chamada com classificação + campos de todos os subtipos (anyOf);
# duas_etapas: classificação barata (modelo abaixo) e depois extração com o schema do subtipo.
LEITOR_VISUAL_DESENHO=unico
LEITOR_VISUAL_MODELO_CLASSIFICACAO=gpt-6-luna
# Esforço de raciocínio (none | minimal | low | medium | high | xhigh | max); vazio omite o
# parâmetro. Tokens de raciocínio são cobrados como saída: usar o menor e medir no gabarito.
LEITOR_VISUAL_ESFORCO_RACIOCINIO=none
LEITOR_VISUAL_MAX_TOKENS_SAIDA=4000
# Como cada modelo conta tokens de imagem (JSON): patches de patch_px × multiplicador, com
# limite de patches por imagem. Sem entrada para o modelo: 32 px, 1.2 e 30000 (provisório;
# o plano só documenta o 1.2 do gpt-6-astra).
MODELOS_IMAGEM={"gpt-6-astra":{"patch_px":32,"multiplicador":1.2,"patches_max":30000}}
# fake | nenhum (Fase 1, sem segundo leitor) | paddleocr (Fase 2)
LEITOR_TEXTO_PROVIDER=fake
# PaddleOCR em CPU (extra `ocr`: uv sync --extra ocr). Sem modelos explícitos, o idioma
# escolhe (pt → PP-OCRv6 medium). Mais rápido: PP-OCRv5_mobile_det + latin_PP-OCRv5_mobile_rec.
PADDLEOCR_IDIOMA=pt
PADDLEOCR_MODELO_DETECCAO=
PADDLEOCR_MODELO_RECONHECIMENTO=
# Instâncias do modelo por processo (~1,3 GB de memória cada) e threads de CPU por instância.
PADDLEOCR_INSTANCIAS=1
PADDLEOCR_THREADS_CPU=4
# oneDNN quebra a inferência no Paddle 3.3.1 em CPU; deixe false.
PADDLEOCR_MKLDNN=false
# Confiança mínima do reconhecimento (vazio = padrão do PaddleOCR).
PADDLEOCR_SCORE_MIN=
# Carrega os pesos e roda uma inferência no startup da API.
LEITOR_TEXTO_AQUECER=true
# ocr (caixas do OCR clássico) | fake
LOCALIZADOR_PROVIDER=fake

# --- Ancoragem e releitura ---------------------------------------------------------------------
# Região onde o valor pode estar, em alturas do rótulo: à direita na mesma linha, ou abaixo.
ANCORAGEM_REGIAO_PADRAO={"direita_max_alturas": 25, "abaixo_max_alturas": 3, "abaixo_folga_alturas": 8}
# Ajustes por subtipo, ex.: {"CNH": {"direita_max_alturas": 30, "abaixo_max_alturas": 2, "abaixo_folga_alturas": 8}}
ANCORAGEM_REGIOES={}
# Confusões do OCR (letra, dígito). Valem só para o texto do OCR, conforme o tipo do campo.
ANCORAGEM_CONFUSOES=["O0", "Q0", "D0", "I1", "L1", "S5", "Z2", "B8", "G6"]
ANCORAGEM_ROTULO_SIMILARIDADE_MIN=0.8
# Diferença de um caractere conta como ancoragem PARCIAL só em valores com pelo menos N caracteres.
ANCORAGEM_PARCIAL_TAMANHO_MIN=8
ANCORAGEM_PALAVRAS_MAX=8
# Recorte da releitura: margem (fração da caixa e mínimo em px), altura mínima e ampliação máxima.
RELEITURA_MARGEM=0.25
RELEITURA_MARGEM_MIN_PX=12
RELEITURA_ALTURA_MIN_PX=96
RELEITURA_AMPLIACAO_MAX=4
# Provider visual de reserva; vazio = sem fallback.
PROVIDER_FALLBACK=
# Tempo limite total de cada chamada a provider, em segundos (inclui novas tentativas).
PROVIDER_TIMEOUT_S=30
# Novas tentativas em 429, 5xx e erro de conexão: espera exponencial com jitter.
PROVIDER_TENTATIVAS_MAX=4
PROVIDER_ESPERA_INICIAL_S=0.5
PROVIDER_ESPERA_MAX_S=8
# Chave e endpoint da OpenAI (nunca versionar a chave).
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Diretório das respostas gravadas usadas pelos providers fake.
FAKE_GRAVACOES_DIR=dados/sintetico/gravacoes

# --- Retenção -----------------------------------------------------------------------------
# Pacote de auditoria de cada processamento: 8h | 16h | null (sem expiração; exige
# finalidade definida com quem cuida de LGPD).
ARTEFATOS_TTL=8h
# Casos em revisão (registro próprio): duração livre (30d, 72h…) ou null.
CASOS_REVISAO_TTL=null
# Intervalo do job de limpeza, em segundos. Ele é quem garante 8h/16h; o lifecycle do S3
# (1 dia) é só rede de segurança.
LIMPEZA_INTERVALO_S=300

# --- API ----------------------------------------------------------------------------------
# Código HTTP para "imagem válida, sem como extrair os campos críticos": 422 (sugerido) ou 400.
HTTP_STATUS_FALHA_EXTRACAO=422
# Tamanho máximo do arquivo decodificado, em bytes (10 MB).
ARQUIVO_MAX_BYTES=10485760
# Resolução máxima aceita (largura × altura), contra imagens-bomba.
IMAGEM_PIXELS_MAX=50000000
# Maior lado da imagem normalizada, em pixels.
IMAGEM_LADO_MAX_PX=2048
# Resolução de renderização de PDF.
PDF_DPI=200
# Documento recortado cabe em ~1600 × 1000 px antes de ir ao provider (nunca amplia).
ALVO_LADO_MAIOR_PX=1600
ALVO_LADO_MENOR_PX=1000
# Localização do documento: área relativa aceita do quadrilátero e margem de borda.
DOCUMENTO_AREA_MIN=0.2
DOCUMENTO_AREA_MAX=0.97
DOCUMENTO_MARGEM_BORDA=0.01
# Limiares de qualidade (provisórios; calibrar na partição de ajuste). Reprovação = 422.
# conteúdo: desvio-padrão do cinza (abaixo = NENHUM_DOCUMENTO); nitidez: variância do
# Laplaciano (abaixo = IMAGEM_DESFOCADA); reflexo: maior mancha estourada (acima =
# REFLEXO_EXCESSIVO); corte: fração do contorno colada na borda (acima = DOCUMENTO_CORTADO).
QUALIDADE_CONTEUDO_MIN=3.0
QUALIDADE_NITIDEZ_MIN=15.0
QUALIDADE_REFLEXO_MAX=0.08
QUALIDADE_CORTE_MAX=0.2
# Heurísticas de captura (só sinalizam) e como combinar com o VLM:
# vlm | heuristica | qualquer (uma das duas) | ambas (as duas concordam).
CAPTURA_COPIA_SATURACAO_MAX=10.0
CAPTURA_PRINT_REPETIDOS_MIN=0.6
CAPTURA_PRINT_RUIDO_MAX=0.8
SINALIZACAO_CAPTURA_FONTE=qualquer
# Campo crítico NAO_VERIFICAVEL (ex.: RG fora de SP, sem dígito verificador) pode ser
# aprovado? Padrão conservador: não (vai para revisão). Decisão em aberto.
APROVAR_CRITICO_NAO_VERIFICAVEL=false

# --- Banco (PostgreSQL) -------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://extracao:extracao@localhost:5432/extracao
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Objetos (S3 / RustFS local) ----------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGIAO=us-east-1
S3_BUCKET=extracao-auditoria
S3_ACCESS_KEY_ID=extracao
S3_SECRET_ACCESS_KEY=extracao-segredo-local
# Criptografia em repouso de todo objeto: AES256 (SSE-S3) ou aws:kms.
S3_SSE=AES256
# Chave KMS quando S3_SSE=aws:kms.
S3_SSE_KMS_KEY_ID=

# --- Custos e limites ---------------------------------------------------------------------
# Preço padrão em US$ por milhão de tokens, por modelo (JSON). fator_batch/fator_flex
# aplicam o desconto das rodadas mais baratas (0.5 = metade). Padrão: tabela do plano.
PRECOS_MODELOS={"gpt-6-luna":{"entrada":0.10,"saida":0.50},"gpt-6.1-terra":{"entrada":1.0,"saida":5.0},"gpt-6.1-sol":{"entrada":2.0,"saida":10.0},"gpt-6-astra":{"entrada":10.0,"saida":50.0}}
# Câmbio US$ → R$ (plano: fechamento de 26/10/2026).
CAMBIO_USD_BRL=5.40
# Concorrência e tokens por minuto por provider (JSON). Tokens de imagem contam no limite.
PROVIDER_LIMITES={"openai":{"concorrencia":8,"tokens_por_minuto":2000000,"tokens_estimados_por_chamada":4000}}

# --- Observabilidade ----------------------------------------------------------------------
LOG_LEVEL=INFO
# true = JSON (produção); false = texto legível (desenvolvimento).
LOG_JSON=true
AMBIENTE=local
