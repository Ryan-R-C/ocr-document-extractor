# Configuração do serviço. Copie para .env (make setup faz isso) e ajuste.
# Toda configuração passa por app/config.py; nada de constante espalhada no código.

# --- Providers ----------------------------------------------------------------------------
# Fase 0: só os providers `fake` existem (respostas gravadas por hash da imagem, sem custo).
# Valores do plano para produção: openai / paddleocr (implementados nas Fases 1 e 2).
LEITOR_VISUAL_PROVIDER=fake
LEITOR_VISUAL_MODELO=gpt-6.1-terra
LEITOR_VISUAL_MODELO_ESCALADA=gpt-6.1-sol
# low | high | original | auto. A documentação da OpenAI indica `original` para OCR.
LEITOR_VISUAL_DETALHE=original
LEITOR_TEXTO_PROVIDER=fake
# ocr (caixas do OCR clássico; stub até a Fase 2) | fake
LOCALIZADOR_PROVIDER=fake
# Provider visual de reserva; vazio = sem fallback.
PROVIDER_FALLBACK=
# Tempo limite total de cada chamada a provider, em segundos (inclui novas tentativas).
PROVIDER_TIMEOUT_S=30
# Diretório das respostas gravadas usadas pelos providers fake.
FAKE_GRAVACOES_DIR=dados/sintetico/gravacoes

# --- Retenção -----------------------------------------------------------------------------
# Pacote de auditoria de cada processamento: 8h | 16h | null (sem expiração; exige
# finalidade definida com quem cuida de LGPD).
ARTEFATOS_TTL=8h
# Casos em revisão (registro próprio): duração livre (30d, 72h…) ou null.
CASOS_REVISAO_TTL=null
# Intervalo do job de limpeza, em segundos. Ele é quem garante 8h/16h; o lifecycle do S3
# (1 dia) é só rede de segurança.
LIMPEZA_INTERVALO_S=300

# --- API ----------------------------------------------------------------------------------
# Código HTTP para "imagem válida, sem como extrair os campos críticos": 422 (sugerido) ou 400.
HTTP_STATUS_FALHA_EXTRACAO=422
# Tamanho máximo do arquivo decodificado, em bytes (10 MB).
ARQUIVO_MAX_BYTES=10485760
# Resolução máxima aceita (largura × altura), contra imagens-bomba.
IMAGEM_PIXELS_MAX=50000000
# Maior lado da imagem normalizada, em pixels.
IMAGEM_LADO_MAX_PX=2048
# Resolução de renderização de PDF.
PDF_DPI=200
# Campo crítico NAO_VERIFICAVEL (ex.: RG fora de SP, sem dígito verificador) pode ser
# aprovado? Padrão conservador: não (vai para revisão). Decisão em aberto.
APROVAR_CRITICO_NAO_VERIFICAVEL=false

# --- Banco (PostgreSQL) -------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://extracao:extracao@localhost:5432/extracao
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Objetos (S3 / RustFS local) ----------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGIAO=us-east-1
S3_BUCKET=extracao-auditoria
S3_ACCESS_KEY_ID=extracao
S3_SECRET_ACCESS_KEY=extracao-segredo-local
# Criptografia em repouso de todo objeto: AES256 (SSE-S3) ou aws:kms.
S3_SSE=AES256
# Chave KMS quando S3_SSE=aws:kms.
S3_SSE_KMS_KEY_ID=

# --- Custos e limites ---------------------------------------------------------------------
# Preço padrão em US$ por milhão de tokens, por modelo (JSON). fator_batch/fator_flex
# aplicam o desconto das rodadas mais baratas (0.5 = metade). Padrão: tabela do plano.
PRECOS_MODELOS={"gpt-6-luna":{"entrada":0.10,"saida":0.50},"gpt-6.1-terra":{"entrada":1.0,"saida":5.0},"gpt-6.1-sol":{"entrada":2.0,"saida":10.0},"gpt-6-astra":{"entrada":10.0,"saida":50.0}}
# Câmbio US$ → R$ (plano: fechamento de 26/10/2026).
CAMBIO_USD_BRL=5.40
# Concorrência e tokens por minuto por provider (JSON). Tokens de imagem contam no limite.
PROVIDER_LIMITES={"openai":{"concorrencia":8,"tokens_por_minuto":2000000,"tokens_estimados_por_chamada":4000}}

# --- Observabilidade ----------------------------------------------------------------------
LOG_LEVEL=INFO
# true = JSON (produção); false = texto legível (desenvolvimento).
LOG_JSON=true
AMBIENTE=local
